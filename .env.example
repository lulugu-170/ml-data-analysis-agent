# DeepSeek 配置（OpenAI 兼容接口）
# API Key 获取：https://platform.deepseek.com  ->  API keys
# 注意：DeepSeek 仅新用户赠送额度，用完收费
# OPENAI_API_KEY=sk-your-deepseek-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODEL=deepseek-chat

# 智谱 GLM-4-Flash 配置（永久免费，支持 function calling）—— 默认推荐
# API Key 获取：https://open.bigmodel.cn  ->  控制台  ->  API Keys
OPENAI_API_KEY=your-zhipu-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash
